APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_TIMEZONE=America/Caracas

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# Portal paciente: login con cédula + patient_portal_password (texto plano en Integracorp)
AUTH_PROVIDER_DRIVER=telemedicine_eloquent
AUTH_MODEL=App\Models\TelemedicinePatient
# Para tests con User local: AUTH_PROVIDER_DRIVER=eloquent y AUTH_MODEL=App\Models\User
# MediChat — “Olvidé mi clave” en el login
PORTAL_SUPPORT_WHATSAPP_PHONE=+584242132112
PORTAL_SUPPORT_WHATSAPP_NAME=MediChat

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Ultramsg WhatsApp API (Integracorp)
ULTRAMSG_INSTANCE_ID=
ULTRAMSG_TOKEN=
ULTRAMSG_BASE_URL=https://api.ultramsg.com

# -----------------------------------------------------------------------------
# Origen de datos del portal (contingencia)
# - database: MySQL directa (modo actual / fallback)
# - api: portal-paciente-api (recomendado en producción)
# -----------------------------------------------------------------------------
DATA_SOURCE=api
PORTAL_PACIENTE_API_URL=http://localhost:4100
PORTAL_PACIENTE_API_TIMEOUT=8
PORTAL_PACIENTE_API_CONNECT_TIMEOUT=3
PORTAL_PACIENTE_API_RETRY=1
PORTAL_PACIENTE_API_RETRY_SLEEP_MS=150

# -----------------------------------------------------------------------------
# Integracorp — documentos clínicos (telemedicina-doc/)
# Producción: https://integracorp.tudrgroup.com/storage/telemedicina-doc/...
# Funciona en DATA_SOURCE=api y DATA_SOURCE=database
# -----------------------------------------------------------------------------
INTEGRACORP_URL=https://integracorp.tudrgroup.com
# INTEGRACORP_STORAGE_BASE_URL=https://integracorp.tudrgroup.com/storage
# Disco/NFS opcional (si comparten volumen con Integracorp; tiene prioridad sobre URL)
# CLINICAL_STORAGE_ROOT=/var/www/integracorp/storage/app/public
# INTEGRACORP_DOWNLOAD_TIMEOUT=30
# INTEGRACORP_CONNECT_TIMEOUT=5

# Geolocalización de centros de salud (pantalla «Cerca de mí»).
# «osm» usa OpenStreetMap: gratis, sin API key, pensado para desarrollo y
# pruebas. Al pasar a producción, cambiar a «google» y definir GOOGLE_MAPS_KEY.
GEO_DRIVER=osm
GEO_USER_AGENT="PortalPacienteTDG/1.0 (+https://portal-paciente.test)"
# GOOGLE_MAPS_KEY=
